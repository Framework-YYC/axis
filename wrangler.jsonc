// Axis Worker configuration.
// - `staging` and `production` are separate Workers and separate D1 databases. Production is deployed only by the manual
//   "Deploy production" workflow, with the owner's explicit approval for that release (see docs/SECURITY.md).
// - Identifiers here are not secrets. No account id or secret belongs in this file.
// - workers_dev and preview_urls are OFF so the only way in is the custom domain behind Cloudflare Access.
//   The Worker also validates the Access JWT itself (defence in depth), including for static assets.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  // The top level is LOCAL DEVELOPMENT ONLY (`wrangler dev`). Deploys always name an environment.
  "name": "axis-local-dev",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-01",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // Every request, static files included, runs through the Worker first so authentication cannot be skipped.
    "run_worker_first": true
  },
  "observability": { "enabled": true, "head_sampling_rate": 0.1 },
  "vars": { "ENVIRONMENT": "development" },
  "d1_databases": [
    { "binding": "AXIS_DB", "database_name": "axis-local", "database_id": "local-dev", "migrations_dir": "migrations" }
  ],
  "env": {
    "staging": {
      "name": "axis-staging",
      "workers_dev": false,
      "preview_urls": false,
      "routes": [{ "pattern": "axis-staging.frameworktools.ca", "custom_domain": true }],
      // No Cron Trigger: the account has 5 free slots, 4 belong to other Workers and the last one is used by production.
      // Staging applies assistant_inbox requests (and refreshes stale briefings) when the owner opens or polls the app.
      "triggers": { "crons": [] },
      "vars": {
        "ENVIRONMENT": "staging",
        "ACCESS_TEAM_DOMAIN": "frameworkco-admin.cloudflareaccess.com",
        "ACCESS_AUD": "d721a537fe6efc99a65e5609caa8a0ec690860df006dfda7676df4e67fe277e3"
      },
      "d1_databases": [
        {
          "binding": "AXIS_DB",
          "database_name": "axis-staging",
          "database_id": "600a5970-d009-4648-8124-34ae2aa0e585",
          "migrations_dir": "migrations"
        }
      ]
      // Secret (never in this file):  wrangler secret put OWNER_EMAIL --env staging
    },
    "production": {
      "name": "axis-production",
      "workers_dev": false,
      "preview_urls": false,
      "routes": [{ "pattern": "axis.frameworktools.ca", "custom_domain": true }],
      // Every minute: apply pending assistant requests (assistant_inbox) and refresh stored briefings. Uses the account's last free cron slot.
      "triggers": { "crons": ["* * * * *"] },
      "vars": {
        "ENVIRONMENT": "production",
        "ACCESS_TEAM_DOMAIN": "frameworkco-admin.cloudflareaccess.com",
        "ACCESS_AUD": "03df313d1e458936e662aa3ce76d672eec1355e7e8765819c7c3443efaf706f1"
      },
      "d1_databases": [
        {
          "binding": "AXIS_DB",
          "database_name": "axis-production",
          "database_id": "e4941aa5-13fb-44b5-be7f-885b5807b79f",
          "migrations_dir": "migrations"
        }
      ]
      // Secret (never in this file):  wrangler secret put OWNER_EMAIL --env production
    }
  }
}
